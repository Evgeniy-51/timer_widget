<UserControl x:Class="TimerWidget.Controls.SevenSegmentDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimerWidget.Controls"
             Height="52">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <c:SevenSegmentDigit x:Name="H1" Width="28" Height="48" Margin="1,0"/>
        <c:SevenSegmentDigit x:Name="H0" Width="28" Height="48" Margin="1,0"/>
        <c:ColonMark x:Name="C1" Width="18" Height="48" Margin="2,0"/>
        <c:SevenSegmentDigit x:Name="M1" Width="28" Height="48" Margin="1,0"/>
        <c:SevenSegmentDigit x:Name="M0" Width="28" Height="48" Margin="1,0"/>
        <StackPanel x:Name="SecHost" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,2">
            <c:SevenSegmentDigit x:Name="S1" Width="14" Height="24" Margin="0,0,1,0"/>
            <c:SevenSegmentDigit x:Name="S0" Width="14" Height="24"/>
        </StackPanel>
    </StackPanel>
</UserControl>
